# Port the API listens on. The admin dashboard's NEXT_PUBLIC_API_BASE must use
# the same port.
PORT=2700

# Origin of the admin dashboard (scheme + host + port). Always allowed by CORS.
ADMIN_BASE_URL=http://localhost:3001

# Extra browser origins allowed by CORS, comma-separated. ADMIN_BASE_URL is
# always allowed. Leave both empty to allow every origin (development only).
CORS_ALLOWED_ORIGINS=

DATABASE_URL="postgresql://username:password@your-neon-pooler-host/database?sslmode=require&channel_binding=require"

# Redis for the job queue, cache and rate limiting (required).
REDIS_URL=redis://default:password@your-redis-host:6379

# Decrypts the secrets stored in the database. Exactly 64 hex characters
# (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value, and never rotate it without re-encrypting.
MASTER_ENCRYPTION_KEY=replace_with_64_hex_characters

# JWT access tokens. The signing secret is required (at least 32 characters);
# the server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every issued access token (clients silently refresh).
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
# Lifetimes in seconds. Access: 60–3600 (default 900 = 15 min).
# Refresh: 3600–7776000 (default 604800 = 7 days).
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Login lockout: failed attempts before lockout, and how long it lasts.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900

# Uploads. Size in bytes (default 50 MB); MIME types comma-separated.
UPLOAD_AUDIO_MAX_BYTES=52428800
UPLOAD_AUDIO_MIME_TYPES=audio/mpeg,audio/wav,audio/aac,audio/ogg,audio/flac
UPLOAD_TICKET_TTL_SECONDS=900

# Cloudinary account used for all uploads (required).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_AUDIO_FOLDER=slimshot/audio

# One-time bootstrap for the first owner account. Read once at boot when no
# admin exists yet; safe to remove from the environment afterward.
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-immediately
