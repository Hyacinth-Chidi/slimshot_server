PORT=3000
DATABASE_URL="postgresql://username:password@your-neon-pooler-host/database?sslmode=require&channel_binding=require"
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_AUDIO_FOLDER=slimshot/audio
# One-time bootstrap for the first owner account. Read once at boot when no
# admin exists yet; safe to remove from the environment afterward.
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-immediately
