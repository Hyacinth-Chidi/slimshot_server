# Listens for GitHub's push webhook and deploys pushes to main.
# Installed as /etc/systemd/system/slimshot-webhook.service by
# deploy/scripts/setup-webhook.sh, which fills in __APP_DIR__.
#
# The listener is the one piece that answers requests from the internet (via
# nginx, 127.0.0.1:9000), so it runs as the unprivileged `slimshot-hook` user.
# A sudo rule (/etc/sudoers.d/slimshot-webhook) lets it run exactly one thing as
# root: deploy/scripts/webhook-deploy.sh. hooks.json runs even that only for
# requests signed with the secret in /etc/slimshot/webhook.env.
#
# No NoNewPrivileges=: it would block that single sudo.

[Unit]
Description=SlimShot deploy webhook (signed GitHub push to main runs deploy.sh)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=slimshot-hook
Group=slimshot-hook
EnvironmentFile=/etc/slimshot/webhook.env
Environment=APP_DIR=__APP_DIR__
ExecStart=/usr/bin/webhook -hooks __APP_DIR__/deploy/webhook/hooks.json -template -hotreload -ip 127.0.0.1 -port 9000 -verbose
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
