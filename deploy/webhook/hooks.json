[
  {
    "id": "deploy",
    "execute-command": "/usr/bin/sudo",
    "command-working-directory": "{{ getenv "APP_DIR" }}",
    "http-methods": ["POST"],
    "response-message": "Received.",
    "trigger-rule-mismatch-http-response-code": 403,
    "pass-arguments-to-command": [
      { "source": "string", "name": "-n" },
      { "source": "string", "name": "{{ getenv "APP_DIR" }}/deploy/scripts/webhook-deploy.sh" },
      { "source": "header", "name": "X-Github-Event" },
      { "source": "payload", "name": "ref" },
      { "source": "payload", "name": "after" },
      { "source": "payload", "name": "pusher.name" }
    ],
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv "WEBHOOK_SECRET" | js }}",
        "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
      }
    }
  }
]
