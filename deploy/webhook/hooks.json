[
  {
    "id": "deploy",
    "execute-command": "{{ getenv "APP_DIR" }}/deploy/scripts/webhook-deploy.sh",
    "command-working-directory": "{{ getenv "APP_DIR" }}",
    "http-methods": ["POST"],
    "response-message": "Received.",
    "trigger-rule-mismatch-http-response-code": 403,
    "pass-environment-to-command": [
      { "source": "header", "name": "X-Github-Event", "envname": "GITHUB_EVENT" },
      { "source": "payload", "name": "ref", "envname": "GITHUB_REF" },
      { "source": "payload", "name": "after", "envname": "GITHUB_SHA" },
      { "source": "payload", "name": "pusher.name", "envname": "GITHUB_PUSHER" }
    ],
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv "WEBHOOK_SECRET" | js }}",
        "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
      }
    }
  }
]
