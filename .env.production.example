# Production settings for the VPS. Do not edit this file on the server:
#   ./deploy/scripts/init-env.sh   copies it to .env with every __GENERATED_*__
#                                  value replaced by a fresh random secret.
# Then open .env and replace every CHANGE_ME. deploy.sh refuses to run while
# any CHANGE_ME or __GENERATED_*__ is left.
#
# A value containing $ must be wrapped in single quotes ('pa$$word'), or
# Docker Compose will try to expand it.
#
# Keep a copy of the finished .env in your password manager: without
# MASTER_ENCRYPTION_KEY the saved provider keys cannot be read, and changing
# IDENTITY_HMAC_SECRET after users exist breaks bonus history.

NODE_ENV=production
PORT=2700
# nginx sits in front of the API: one trusted hop.
TRUST_PROXY=1

# Where the admin dashboard runs (allowed by CORS). It's hosted on this VPS
# (slimshot-admin repo, docs/deploy/vps-setup.md). To use a dashboard running on
# your PC instead, put http://localhost:3001 here or in CORS_ALLOWED_ORIGINS.
ADMIN_BASE_URL=https://slimshot-admin.techfamz.com
# More browser origins, comma-separated. Usually empty.
CORS_ALLOWED_ORIGINS=

# --- Database and Redis: the containers in docker-compose.prod.yml ---------
POSTGRES_PASSWORD=__GENERATED_POSTGRES_PASSWORD__
DATABASE_URL=postgresql://slimshot:__GENERATED_POSTGRES_PASSWORD__@postgres:5432/slimshot
REDIS_PASSWORD=__GENERATED_REDIS_PASSWORD__
REDIS_URL=redis://default:__GENERATED_REDIS_PASSWORD__@redis:6379

# --- Secrets (generated) ----------------------------------------------------
JWT_ACCESS_SECRET=__GENERATED_JWT_ACCESS_SECRET__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
USER_JWT_SECRET=__GENERATED_USER_JWT_SECRET__
USER_ACCESS_TTL_SECONDS=900
USER_REFRESH_TTL_SECONDS=2592000
IDENTITY_HMAC_SECRET=__GENERATED_IDENTITY_HMAC_SECRET__
MASTER_ENCRYPTION_KEY=__GENERATED_MASTER_ENCRYPTION_KEY__

# --- First owner account ----------------------------------------------------
# Created at the first start when no admin exists. Sign in, then you may
# delete these two lines and redeploy.
ADMIN_BOOTSTRAP_EMAIL=CHANGE_ME
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_SECONDS=900

# --- Asset uploads (Cloudinary) ---------------------------------------------
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_AUDIO_FOLDER=slimshot/audio
UPLOAD_AUDIO_MAX_BYTES=52428800
UPLOAD_AUDIO_MIME_TYPES=audio/mpeg,audio/wav,audio/aac,audio/ogg,audio/flac
UPLOAD_TICKET_TTL_SECONDS=900

# --- Auto caption -------------------------------------------------------------
# Provider API keys are added in the dashboard (Settings → Providers), not here.
CAPTION_MAX_UPLOAD_BYTES=52428800
CAPTION_RESULT_TTL_SECONDS=180
CAPTION_CONCURRENCY=4
CAPTION_DEEPGRAM_MODEL=nova-3
CAPTION_ELEVENLABS_MODEL=scribe_v2

# --- App sign-in --------------------------------------------------------------
# The OAuth *Web* client ID from Google Cloud (comma-separated if several).
GOOGLE_CLIENT_IDS=CHANGE_ME
# Sign-in codes by email. Production refuses EMAIL_SENDER=log.
EMAIL_SENDER=smtp
SMTP_HOST=CHANGE_ME
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM="SlimShot <CHANGE_ME>"

# --- Rewarded ads -------------------------------------------------------------
# Your AdMob rewarded ad unit ID(s), comma-separated. Required in production.
ADMOB_AD_UNIT_IDS=CHANGE_ME
